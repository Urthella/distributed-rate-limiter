# Gateway listen port (overrides listen.port from the config file)
PORT=8080

# Path to the gateway config file (default: ./config/gateway.json)
CONFIG_PATH=./config/gateway.json

# Optional: set to switch the rate-limit store from in-memory to Redis.
# When set, every gateway instance pointing at the same Redis shares one
# atomic view of all counters (distributed rate limiting).
# REDIS_URL=redis://127.0.0.1:6379

# Port for the bundled demo upstream server (node dist/demo-upstream.js)
UPSTREAM_PORT=9100

# Note: the gateway reads plain environment variables; it does not load .env
# automatically (no dotenv dependency). Copy values into your shell or process
# manager, e.g. PowerShell:  $env:PORT = "8080"
